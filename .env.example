# Copy to .env.local and fill in. Without Supabase keys the site runs in demo mode (local file).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin login for the family (/admin)
ADMIN_PASSWORD=
ADMIN_SECRET=            # any long random string

# Supabase (database + photo storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=products

# Razorpay (UPI / cards). Use test keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional photo pipeline
REMOVE_BG_API_KEY=       # background removal (remove.bg)
ANTHROPIC_API_KEY=       # AI drafts of title and description
ANTHROPIC_MODEL=claude-sonnet-5-5

# Live try-on face model (defaults to Google's hosted file)
NEXT_PUBLIC_FACE_MODEL_URL=
